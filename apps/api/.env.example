PORT=3000
IMG_SIGN_SECRET=change-me-to-a-random-32-byte-string
# Только источники, реально портированные на TS (фаза 1, docs/03-parsers.md) — остальные 16
# из 23 зарегистрированы в @tanuki/parsers, но их вызовы вернут 404, пока не подойдёт очередь.
ENABLED_SOURCES=READMANGA_RU,MINTMANGA,SELFMANGA,SEIMANGA,USAGI,ALLHENTAI,DESUME
# Опционально: аккаунт Grouple-сети (ReadManga/MintManga/SelfManga/SeiManga/Usagi) для доступа
# к главам, требующим авторизации. Без этих переменных источники работают анонимно.
GROUPLE_USERNAME=
GROUPLE_PASSWORD=
REDIS_URL=redis://localhost:6379
