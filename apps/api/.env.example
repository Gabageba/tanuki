PORT=3000
IMG_SIGN_SECRET=change-me-to-a-random-32-byte-string
# Все 23 источника из docs/03-parsers.md портированы на TS. HENTAILIB/ZENMANGA/ACOMICS несут
# isBroken: true (унаследовано от апстримного kotatsu enum, не от этого порта) и отдаются как
# status: 'down' через /sources, но зарегистрированы, как и остальные.
# По умолчанию включены все источники. Перечислите здесь ID через запятую, чтобы отключить конкретные.
DISABLED_SOURCES=
# Опционально: аккаунт Grouple-сети (ReadManga/MintManga/SelfManga/SeiManga/Usagi) для доступа
# к главам, требующим авторизации. Без этих переменных источники работают анонимно.
REDIS_URL=redis://localhost:6379
GROUPLE_USERNAME=
GROUPLE_PASSWORD=
# AllHentai использует отдельный SSO-шлюз qawa.org со своей учёткой — GROUPLE_USERNAME/PASSWORD
# для него не подходят. Без этих переменных каталог ALLHENTAI недоступен целиком (SOURCE_AUTH_REQUIRED),
# т.к. авторизация там нужна для любого запроса, а не только для отдельных глав.
ALLHENTAI_USERNAME=
ALLHENTAI_PASSWORD=
# LibSocial (MANGALIB/HENTAILIB/YAOILIB, один аккаунт на всю сеть): логин закрыт reCAPTCHA,
# поэтому этот процесс использует не username/password напрямую, а каталог токенов, полученных
# вручную через `pnpm --filter @tanuki/parsers login:libsocial <SOURCE_ID>` (открывает
# настоящий браузер — капчу решает человек). По умолчанию ./data/libsocial-tokens относительно
# корня репозитория; без файла для конкретного источника главы, требующие авторизации, отдают
# SOURCE_TOKEN_EXPIRED.
LIBSOCIAL_TOKEN_STORE_DIR=
# Опционально, только для скрипта login:libsocial выше (этот процесс их не читает) — заполняют
# форму логина, чтобы вручную оставалось только решить капчу.
LIB_USERNAME=
LIB_PASSWORD=
