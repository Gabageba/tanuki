PORT=3000
IMG_SIGN_SECRET=change-me-to-a-random-32-byte-string
# Все 23 источника из docs/03-parsers.md портированы на TS. YAOICHAN/COMX/ACOMICS/HENCHAN несут
# isBroken: true (сайт не парсится в принципе — см. комментарии у каждого в source-catalog.ts) и
# отдаются как status: 'down' через /sources, но зарегистрированы, как и остальные.
# По умолчанию включены все источники. Перечислите здесь ID через запятую, чтобы отключить конкретные.
DISABLED_SOURCES=
# Опционально: аккаунт Grouple-сети (ReadManga/MintManga/SelfManga/SeiManga/Usagi) для доступа
# к главам, требующим авторизации. Без этих переменных источники работают анонимно.
REDIS_URL=redis://localhost:6379
GROUPLE_USERNAME=
GROUPLE_PASSWORD=
# AllHentai использует отдельный SSO-шлюз qawa.org со своей учёткой — GROUPLE_USERNAME/PASSWORD
# для него не подходят. Без этих переменных каталог ALLHENTAI недоступен целиком (SOURCE_AUTH_REQUIRED),
# т.к. авторизация там нужна для любого запроса, а не только для отдельных глав.
ALLHENTAI_USERNAME=
ALLHENTAI_PASSWORD=
# LibSocial (MANGALIB/HENTAILIB/YAOILIB, один аккаунт на всю сеть): логин закрыт reCAPTCHA,
# поэтому этот процесс использует не username/password напрямую, а каталог токенов, полученных
# вручную через `pnpm --filter @tanuki/parsers login:libsocial <SOURCE_ID>` (открывает
# настоящий браузер — капчу решает человек). По умолчанию ./data/libsocial-tokens относительно
# корня репозитория; без файла для конкретного источника главы, требующие авторизации, отдают
# SOURCE_TOKEN_EXPIRED.
LIBSOCIAL_TOKEN_STORE_DIR=
# Опционально, только для скрипта login:libsocial выше (этот процесс их не читает) — заполняют
# форму логина, чтобы вручную оставалось только решить капчу.
LIB_USERNAME=
LIB_PASSWORD=
# Устойчивость и статусы источников. Circuit breaker гасит трафик к неотвечающему источнику:
# после SOURCE_BREAKER_FAILURE_THRESHOLD ошибок подряд запросы не пропускаются
# SOURCE_BREAKER_RESET_MS, потом идёт одна пробная. Статус источника (ok/degraded/down) живёт
# отдельно и сам собой не восстанавливается — его снимает либо серия
# SOURCE_RECOVERY_SUCCESS_THRESHOLD успешных живых запросов, либо успешная ночная проверка.
SOURCE_BREAKER_FAILURE_THRESHOLD=5
SOURCE_BREAKER_RESET_MS=180000
SOURCE_RECOVERY_SUCCESS_THRESHOLD=5
SOURCE_MAX_CONCURRENCY=4
SOURCE_QUEUE_LIMIT=20
SOURCE_HTTP_TIMEOUT_MS=20000
# Ночная проверка источников: раз в сутки прогоняет по каждому полный путь чтения
# (getList → getDetails → getPages) и по итогу двигает статус. После
# SOURCE_PROBE_FAILURE_THRESHOLD упавших ночей подряд источник считается неработающим.
# В dev обычно выключают: пробник ходит по реальным сайтам.
SOURCE_PROBE_ENABLED=true
SOURCE_PROBE_CRON=0 3 * * *
SOURCE_PROBE_FAILURE_THRESHOLD=3
SOURCE_PROBE_CONCURRENCY=3
# Новые главы у закладок: раз в 3 часа крон проверяет тайтлы из папок с «Следить за
# обновлениями», раз в сутки чистит снимки глав, которые больше никому не нужны. В dev обычно
# выключают по той же причине, что и пробник.
BOOKMARK_UPDATES_ENABLED=true
BOOKMARK_UPDATES_CRON=0 */3 * * *
BOOKMARK_UPDATES_CONCURRENCY=2
BOOKMARK_SNAPSHOTS_CLEANUP_CRON=30 4 * * *
# Аккаунты и почта. APP_URL подставляется в ссылки писем (подтверждение почты, сброс пароля) —
# должен указывать на фронтенд, а не на этот API.
APP_URL=http://localhost:5173
# Пусто = SMTP не настроен, MailService вместо отправки пишет ссылку в лог — так проще всего
# проверить регистрацию локально. Для реальной отправки в dev поднимите Mailpit (docker-compose,
# UI на localhost:8025) и укажите SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tanuki <noreply@tanuki.local>
# true только за HTTPS — иначе браузер молча откажется принимать cookie сессии по http.
COOKIE_SECURE=false
# true за обратным прокси (nginx и т.п.), иначе IP клиента для rate limit будет всегда адресом
# прокси.
TRUST_PROXY=false

# Личные аккаунты пользователей на источниках (Grouple, AllHentai, LibSocial) шифруются этим
# ключом — 32 байта в base64: `openssl rand -base64 32`. Без ключа привязать аккаунт нельзя.
SOURCE_SECRETS_KEY=
