{
	admin off
	http_port 8080
	https_port 8443
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$CADDY_SITE:localhost} {
	root * /srv
	header X-Robots-Tag noindex
	encode zstd gzip
	route {
		@private path /metrics /metrics/* /api/docs*
		respond @private 404
		@api path /api /api/*
		handle @api {
			reverse_proxy api:3000 {
				flush_interval -1
				header_up X-Forwarded-For {client_ip}
			}
		}
		handle /runtime-config.js {
			header Cache-Control no-store
			file_server
		}
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		@static path_regexp static \.[a-zA-Z0-9]+$
		handle @static {
			header Cache-Control no-cache
			file_server
		}
		handle {
			@navigation header Accept *text/html*
			rewrite @navigation /index.html
			header Cache-Control no-cache
			file_server
		}
	}
}

http://127.0.0.1:8081 {
	respond /health 200
}
