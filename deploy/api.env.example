# Compose env_file format: raw. Однострочные значения, без shell-экранирования и обрамляющих кавычек.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tanuki <noreply@localhost>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
SENTRY_API_DSN=
IMAGE_DOWNLOAD_CONCURRENCY=8
IMAGE_TRANSFORM_CONCURRENCY=1
IMAGE_DOWNLOAD_QUEUE_LIMIT=128
IMAGE_TRANSFORM_QUEUE_LIMIT=32
IMAGE_QUEUE_TIMEOUT_MS=2000
