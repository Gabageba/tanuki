# Self-host: скопируйте в .env; образы берутся из release.env выбранного релиза.
COMPOSE_PROJECT_NAME=tanuki
CONFIG_SCHEMA=1
API_IMAGE=tanuki-api:local
WEB_IMAGE=tanuki-web:local
TANUKI_VERSION=development
APP_URL=http://localhost:8080
CADDY_SITE=:8080
WEB_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Для HTTP localhost и Mailpit; на сервере HTTPS и COOKIE_SECURE=true.
COMPOSE_PROFILES=local
COOKIE_SECURE=false
POSTGRES_PASSWORD=replaceWithRandomHex
IMG_SIGN_SECRET=replaceWithRandomHexAtLeast16Characters
SOURCE_SECRETS_KEY=
METRICS_TOKEN=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tanuki <noreply@localhost>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
SENTRY_API_DSN=
SENTRY_WEB_DSN=
# Для внешнего прокси укажите его точный IP/CIDR, не все private_ranges.
CADDY_TRUSTED_PROXIES=127.0.0.1/32
# При конфликте сети выберите свободную /24 до установки.
TANUKI_SUBNET_PREFIX=172.30.98
