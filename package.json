{
  "name": "tanuki",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:contracts": "turbo run build --filter=@tanuki/contracts",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@tanuki/api & turbo run dev:host --filter=@tanuki/web; wait",
    "docker": "docker compose up -d --build",
    "lint": "turbo run lint && pnpm run lint:styles && pnpm run lint:format && pnpm run lint:i18n",
    "lint:format": "prettier --check .",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:styles": "stylelint \"apps/**/*.scss\" --allow-empty-input",
    "prepare": "husky",
    "start": "docker compose up -d --build && turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tanuki/stylelint-config": "workspace:*",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.14.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  }
}
